# Copy to .env for local development. Never commit real secrets.
# Every value here is a local-only development default.

APP_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker-compose service "postgres", or `pnpm local:postgres` without Docker)
DATABASE_URL=postgresql://momentpath:momentpath@localhost:5432/momentpath

# API
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Number of trusted reverse-proxy hops in front of the API (the web BFF counts as one).
TRUST_PROXY_HOPS=1

# Operator credential for /admin (takedowns). There are no accounts, so this is the only
# privileged identity. Unset leaves the moderation endpoints closed rather than open.
ADMIN_TOKEN=dev-only-admin-token-change-me-0123456789

# Authenticated encryption keyring for gift secrets, share tokens and manage tokens:
# "id:base64(32 bytes)". Comma-separate several keys to rotate; APP_ENCRYPTION_ACTIVE_KEY
# encrypts new data. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
APP_ENCRYPTION_ACTIVE_KEY=dev1

# Storage: "filesystem" (dev/test only) or "s3" (MinIO locally, R2/S3 in production).
STORAGE_DRIVER=filesystem
STORAGE_FS_ROOT=.local/storage
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret-0123456789
# Browser-facing base URL for filesystem-signed media URLs (served through the web BFF).
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/bff/api
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=momentpath-media
S3_ACCESS_KEY_ID=momentpath
S3_SECRET_ACCESS_KEY=momentpath-dev-secret
S3_FORCE_PATH_STYLE=true
# Web only: extra origin allowed by the CSP for images/uploads when STORAGE_DRIVER=s3 (e.g. MinIO).
# MEDIA_ORIGIN=http://localhost:9000

# ---- Payments (Phase 2a) ---------------------------------------------------------------
# Off by default: everything publishes free. Turn on to require Plus/Custom purchases.
BILLING_ENABLED=false
# Razorpay (India: UPI, cards, net banking). Test keys start with rzp_test_ — live keys are
# refused outside APP_ENV=production. Dashboard → Account & Settings → API Keys.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL <WEB_ORIGIN>/webhooks/razorpay, events payment_link.paid,
# payment_link.expired, payment_link.cancelled. Paste the secret you chose there.
# RAZORPAY_WEBHOOK_SECRET=
# Dodo Payments (everyone else; merchant of record). "test" uses test.dodopayments.com.
# DODO_ENVIRONMENT=test
# DODO_API_KEY=
# Dashboard → Webhooks: URL <WEB_ORIGIN>/webhooks/dodo, event payment.succeeded (whsec_…).
# DODO_WEBHOOK_SECRET=
# One-time products created in the Dodo dashboard; their prices must match PRICE_USD_*.
# DODO_PRODUCT_PLUS=pdt_xxx
# DODO_PRODUCT_PRO=pdt_xxx
# DODO_PRODUCT_PLUS_TO_PRO=pdt_xxx
# Prices in minor units (paise / cents). Defaults: ₹99 / ₹199 and $2.99 / $4.99.
# PRICE_INR_PLUS=9900
# PRICE_INR_PRO=19900
# PRICE_USD_PLUS=299
# PRICE_USD_PRO=499
# Web only: shown on the contact, refund and privacy pages (providers require a contact).
# SUPPORT_EMAIL=
# OPERATOR_NAME=MomentPath
