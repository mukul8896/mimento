// Wish Revealer data model.
// Ownership, lifecycle and access control are relational columns with foreign keys.
// Step configuration and themes are JSONB, always validated by @momentpath/contracts.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DELETED
}

/// TEMPLATE: a ready-made template being personalised; its structure is fixed (PLUS).
/// CUSTOM: the full builder (PRO), from scratch or from a template (contracts/structure.ts).
enum ExperienceMode {
  TEMPLATE
  CUSTOM
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  DISABLED
  EXPIRED
  DELETED
}

/// What a surprise needs before it can be published: ready-made templates are free, richer
/// templates and fully custom builds are paid.
enum Tier {
  FREE
  PLUS
  PRO
}

enum EntitlementSource {
  COMPLIMENTARY
  PURCHASE
}

enum PaymentProvider {
  RAZORPAY
  DODO
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
}

enum ModerationState {
  ACTIVE
  TAKEN_DOWN
}

enum ResponseVisibility {
  FULL
  AGGREGATE_ONLY
}

enum VersionState {
  DRAFT
  PUBLISHED
}

enum StepType {
  MESSAGE
  IMAGE
  MULTIPLE_CHOICE
  YES_NO_CHOICE
  SCRATCH_REVEAL
  GIFT_REVEAL
  COUNTDOWN
  PUZZLE
  PHOTO_GALLERY
  VOICE_NOTE
  VIDEO
  PLACE_REVEAL
}

enum GiftKind {
  VOUCHER_CODE
  URL
  QR_IMAGE
  INSTRUCTION
  PHYSICAL_MESSAGE
}

enum MediaStatus {
  PENDING_UPLOAD
  READY
  REJECTED
  DELETED
}

enum ScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
}

enum ReportCategory {
  HARASSMENT
  SEXUAL_CONTENT
  HATE
  SCAM_OR_FRAUD
  VIOLENCE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ActorType {
  USER
  ADMIN
  RECIPIENT
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Anonymous creator identity. There are no accounts: the owner token is the credential.
model UserProfile {
  id             String              @id @default(uuid()) @db.Uuid
  /// Opaque owner identity. Anonymous creators get `anon:<uuid>`; there is no login.
  subject        String              @unique
  /// SHA-256 of the raw owner token. The raw token lives only in the creator's cookie.
  ownerTokenHash String?             @unique
  email          String?
  displayName    String?
  status         UserStatus          @default(ACTIVE)
  /// Last time this owner's cookie or a manage link was used (at most daily). Owners with
  /// nothing left and no visit for the retention period are removed.
  lastSeenAt     DateTime            @default(now()) @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)
  experiences    Experience[]
  ownerKeys      OwnerKey[]
  passkeys       Passkey[]
  media          MediaAsset[]
  auditLogs      AuditLog[]
  idempotency    IdempotencyRecord[]

  @@index([lastSeenAt])
}

model Experience {
  id                String                @id @default(uuid()) @db.Uuid
  ownerId           String                @db.Uuid
  owner             UserProfile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  status            ExperienceStatus      @default(DRAFT)
  moderationState   ModerationState       @default(ACTIVE)
  takedownReason    String?
  /// SHA-256 of the raw share token. The raw token is never stored in plain text.
  accessTokenHash   String?               @unique
  /// AES-256-GCM ciphertext of the raw share token so the owner can copy the link again.
  accessTokenEnc    String?
  /// SHA-256 of the raw manage token. Grants access to THIS experience only, so a shared
  /// recovery link cannot reach the creator's other experiences.
  manageTokenHash   String?               @unique
  /// AES-256-GCM ciphertext of the raw manage token so the creator can copy the link again.
  manageTokenEnc    String?
  activeVersionId   String?               @unique @db.Uuid
  activeVersion     ExperienceVersion?    @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
  templateKey       String?
  mode              ExperienceMode        @default(CUSTOM)
  /// First time the creator changed anything (content, gift, delivery, personal details). Until
  /// then an unfinished surprise is only a template being looked at, not a draft worth keeping.
  editedAt          DateTime?             @db.Timestamptz(3)
  publishedAt       DateTime?             @db.Timestamptz(3)
  expiresAt         DateTime?             @db.Timestamptz(3)
  /// Scheduled opening: before this, the link shows a countdown and no session can start.
  opensAt           DateTime?             @db.Timestamptz(3)
  /// Optional recipient PIN (scrypt, salted). Failed attempts lock the experience for a while.
  pinHash           String?
  pinFailures       Int                   @default(0)
  pinLockedUntil    DateTime?             @db.Timestamptz(3)
  /// Readable short link (/p/<slug>). Only usable with the PIN, which is required to set one.
  slug              String?               @unique
  disabledAt        DateTime?             @db.Timestamptz(3)
  /// Last time the creator or a recipient used it (at most daily). A surprise nobody has
  /// touched for the retention period (RETENTION_DAYS) is deleted.
  lastActivityAt    DateTime              @default(now()) @db.Timestamptz(3)
  /// When the "about to be deleted" reminder went out; cleared by new activity.
  retentionWarnedAt DateTime?             @db.Timestamptz(3)
  deletedAt         DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  versions          ExperienceVersion[]   @relation("Versions")
  media             MediaAsset[]
  sessions          RecipientSession[]
  reports           AbuseReport[]
  entitlement       Entitlement?
  paymentOrders     PaymentOrder[]
  dailyOpens        ExperienceDailyOpen[]

  @@index([ownerId, updatedAt(sort: Desc), id])
  @@index([status, createdAt(sort: Desc), id])
  @@index([lastActivityAt])
}

/// A draft (mutable, one per experience) or an immutable published snapshot.
model ExperienceVersion {
  id                 String             @id @default(uuid()) @db.Uuid
  experienceId       String             @db.Uuid
  experience         Experience         @relation("Versions", fields: [experienceId], references: [id], onDelete: Cascade)
  activeFor          Experience?        @relation("ActiveVersion")
  /// 0 for the draft; 1..n for published versions.
  number             Int
  state              VersionState
  title              String
  theme              Json
  /// Whether individual answers are shown to the creator. Recipients are told before starting.
  responseVisibility ResponseVisibility @default(FULL)
  /// Optimistic-concurrency counter for draft autosave.
  revision           Int                @default(1)
  publishedAt        DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  steps              Step[]
  gifts              Gift[]
  sessions           RecipientSession[]

  @@unique([experienceId, number])
}

model Step {
  id        String            @id @default(uuid()) @db.Uuid
  versionId String            @db.Uuid
  version   ExperienceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Stable identifier preserved across draft saves and published versions.
  key       String            @db.Uuid
  position  Int
  type      StepType
  config    Json
  /// Branching after this step (contracts/flow.ts StepRouting); null means "next in order".
  routing   Json?
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  responses Response[]

  @@unique([versionId, key])
  @@unique([versionId, position])
}

/// Encrypted gift payload for a GIFT_REVEAL step in a specific version.
model Gift {
  id                  String            @id @default(uuid()) @db.Uuid
  versionId           String            @db.Uuid
  version             ExperienceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  stepKey             String            @db.Uuid
  kind                GiftKind
  /// keyId.iv.tag.ciphertext (base64url), AES-256-GCM, AAD bound to version and step.
  payloadEnc          String
  /// QR image media referenced by the secret, kept relational for ownership and cleanup.
  mediaId             String?           @db.Uuid
  media               MediaAsset?       @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  oneTimeReveal       Boolean           @default(false)
  revealedAt          DateTime?         @db.Timestamptz(3)
  revealedBySessionId String?           @db.Uuid
  revealCount         Int               @default(0)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([versionId, stepKey])
}

model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  ownerId      String      @db.Uuid
  owner        UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  experienceId String      @db.Uuid
  experience   Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  storageKey   String      @unique
  status       MediaStatus @default(PENDING_UPLOAD)
  scanStatus   ScanStatus  @default(NOT_SCANNED)
  mimeType     String
  declaredSize Int
  sizeBytes    Int?
  width        Int?
  height       Int?
  /// Re-encoded copies made by the media pipeline (no metadata survives re-encoding). Recipients
  /// get the display copy; the editor shows the thumbnail. Null until processed.
  displayKey   String?
  thumbKey     String?
  /// Set once the pipeline has scanned and processed the upload (whatever the outcome).
  processedAt  DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  gifts        Gift[]

  @@index([experienceId, status])
  @@index([status, processedAt])
  @@index([ownerId])
}

/// Anonymous recipient progress. No IP address, user agent or location is stored.
model RecipientSession {
  id            String            @id @default(uuid()) @db.Uuid
  experienceId  String            @db.Uuid
  experience    Experience        @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  versionId     String            @db.Uuid
  version       ExperienceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token held by the recipient's browser.
  tokenHash     String            @unique
  /// What this recipient was told: true if the creator can see individual answers.
  answersShared Boolean
  startedAt     DateTime          @default(now()) @db.Timestamptz(3)
  lastActiveAt  DateTime          @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?         @db.Timestamptz(3)
  closedAt      DateTime?         @db.Timestamptz(3)
  expiresAt     DateTime          @db.Timestamptz(3)
  responses     Response[]

  @@index([experienceId, startedAt])
  @@index([expiresAt])
}

model Response {
  id          String           @id @default(uuid()) @db.Uuid
  sessionId   String           @db.Uuid
  session     RecipientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepId      String           @db.Uuid
  step        Step             @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepKey     String           @db.Uuid
  answer      Json
  submittedAt DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, stepId])
  @@index([stepId])
}

model Template {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String
  tier        Tier     @default(FREE)
  version     Int      @default(1)
  content     Json
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// What has been unlocked for one experience. Bound to the experience rather than the creator:
/// without accounts a creator is only as durable as a cookie, but an experience keeps its manage
/// link. One row per experience; upgrading replaces the tier.
model Entitlement {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId String            @unique @db.Uuid
  experience   Experience        @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  tier         Tier
  source       EntitlementSource
  note         String?
  /// Payment provider reference (stage 3). Unique so a replayed webhook cannot double-grant.
  providerRef  String?           @unique
  grantedById  String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
}

/// How many times the recipient page was opened, per UTC day. No visitor data is kept.
model ExperienceDailyOpen {
  experienceId String     @db.Uuid
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  day          DateTime   @db.Date
  opens        Int        @default(0)

  @@id([experienceId, day])
}

/// One checkout attempt for one experience at one provider. Kept after the experience is deleted
/// (experienceId becomes null) because it is the record support needs for refunds and disputes.
/// Contains no customer details: the provider's hosted page collects those.
model PaymentOrder {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId      String?            @db.Uuid
  experience        Experience?        @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  tier              Tier
  provider          PaymentProvider
  status            PaymentOrderStatus @default(CREATED)
  /// What the customer is charged, in the currency's minor unit (paise, cents).
  amountMinor       Int
  currency          String             @db.Char(3)
  /// Razorpay payment link id or Dodo checkout session id.
  providerOrderId   String
  /// Set once paid: Razorpay or Dodo payment id.
  providerPaymentId String?
  checkoutUrl       String
  /// Started from Publish: once paid, the experience is published without another click.
  publishOnPaid     Boolean            @default(false)
  createdById       String?            @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  paidAt            DateTime?          @db.Timestamptz(3)

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([status, createdAt])
  @@index([experienceId, createdAt(sort: Desc)])
}

/// Webhook deliveries already processed, so a provider retry is acknowledged without re-running.
model PaymentWebhookEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider   PaymentProvider
  eventId    String
  type       String
  receivedAt DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
}

model AbuseReport {
  id             String         @id @default(uuid()) @db.Uuid
  experienceId   String?        @db.Uuid
  experience     Experience?    @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  category       ReportCategory
  details        String
  status         ReportStatus   @default(OPEN)
  resolutionNote String?
  resolvedById   String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?      @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc), id])
  @@index([experienceId])
}

/// Security-relevant actions. Never contains message bodies, answers, tokens or secrets.
model AuditLog {
  id         String       @id @default(uuid()) @db.Uuid
  actorType  ActorType
  actorId    String?      @db.Uuid
  actor      UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json         @default("{}")
  requestId  String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([createdAt(sort: Desc), id])
}

/// Transactional outbox for reliable asynchronous work (e.g. storage cleanup).
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @db.Timestamptz(3)
  processedAt DateTime?    @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
}

/// Stored results for Idempotency-Key requests (publish and destructive operations).
model IdempotencyRecord {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  user           UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime    @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([expiresAt])
}

/// Further owner tokens for the same creator, one per device signed in with a passkey or an email
/// link, so signing in on a new phone never signs the old one out. Hashed like the main token.
model OwnerKey {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @db.Uuid
  owner      UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash  String      @unique
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([ownerId])
}

/// A WebAuthn passkey that signs a creator back in on any device where it syncs.
model Passkey {
  id           String      @id @default(uuid()) @db.Uuid
  ownerId      String      @db.Uuid
  owner        UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Base64url credential id from the authenticator.
  credentialId String      @unique
  publicKey    Bytes
  counter      BigInt      @default(0)
  transports   String[]
  /// Synced (multi-device) passkeys survive a lost phone; single-device ones do not.
  backedUp     Boolean     @default(false)
  name         String
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime?   @db.Timestamptz(3)

  @@index([ownerId])
}

/// One-time WebAuthn challenges, valid for a few minutes.
model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  challenge String
  /// Set for registration (the creator adding a passkey); null for sign-in.
  ownerId   String?  @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}
