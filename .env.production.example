# Production configuration. Copy to .env.production on the server and fill in real values.
# Never commit the filled-in file. Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

APP_ENV=production
LOG_LEVEL=info

# The domain Caddy serves and obtains a certificate for. No scheme.
DOMAIN=sealed.gift

# Postgres runs in the stack and is never published to the host.
POSTGRES_USER=momentpath
POSTGRES_PASSWORD=
POSTGRES_DB=momentpath

# Public origin, used for cookies (secure flag), redirects and the callback-free recovery links.
WEB_ORIGIN=https://sealed.gift
API_INTERNAL_URL=http://api:4000
API_PORT=4000
# Caddy is the single proxy in front of the API; the web BFF makes two.
TRUST_PROXY_HOPS=2

# The only privileged credential. At least 32 characters; rotating it ends operator sessions.
ADMIN_TOKEN=

# Authenticated encryption for gift secrets, share tokens and manage tokens.
# Rotate by adding a second key and pointing APP_ENCRYPTION_ACTIVE_KEY at it; never remove a key
# while data encrypted with it still exists.
APP_ENCRYPTION_KEYS=k1:
APP_ENCRYPTION_ACTIVE_KEY=k1

# Object storage. Production requires s3 (the API refuses to boot on filesystem).
# Cloudflare R2 is the cheap default: S3-compatible, no egress fees, generous free tier.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=momentpath-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Origin the browser loads images from and uploads to; must be reachable from the browser,
# and is added to the web CSP for img-src/connect-src.
MEDIA_ORIGIN=https://<account-id>.r2.cloudflarestorage.com

# Paid tiers. Leave false until a payment provider is wired up (stage 3); with it on, upgrades
# can only be granted by the operator.
BILLING_ENABLED=false
