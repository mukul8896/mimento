{
  "name": "@momentpath/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm -w exec prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm -w exec prisma generate && nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi:export": "tsc -p tsconfig.build.json && node dist/openapi-export.js ../../packages/api-client/openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@aws-sdk/s3-request-presigner": "3.1137.0",
    "@momentpath/contracts": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "14.0.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "image-size": "2.0.4",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.0",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@momentpath/config": "workspace:*",
    "@momentpath/test-utils": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "^24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  }
}
